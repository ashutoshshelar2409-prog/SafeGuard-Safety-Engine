# SafeGuard Safety Engine Configuration
DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOG_LEVEL=INFO

# Admin key for the /api/reports/{id}/review endpoint.
# Generate a strong random key and paste it here before deploying:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then either:
#   a) Copy this file to .env and fill in the value (requires python-dotenv — see requirements.txt), or
#   b) Export it in your shell before starting the server:
#        export SAFEGUARD_ADMIN_KEY=<your-key>
#
# Leaving this blank (or the placeholder) blocks the endpoint with HTTP 503.
# For local dev without a key, set: SAFEGUARD_ALLOW_INSECURE_ADMIN=1
SAFEGUARD_ADMIN_KEY=
SAFEGUARD_ALLOW_INSECURE_ADMIN=0
